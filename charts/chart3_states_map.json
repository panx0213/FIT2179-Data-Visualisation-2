{
  "title": {
    "text": "Which States Are Most Into K-pop?",
    "subtitle": "Google Trends search interest in 'K-pop' by state, 19 May 2025–19 May 2026 (100 = peak state). Source: Google Trends.",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#666"
  },
  "width": "container",
  "height": 480,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "padding": 12,
      "offset": 12,
      "columns": 0
    }
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/au-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "values": [
                {
                  "state": "Victoria",
                  "interest": 100,
                  "abbrev": "VIC"
                },
                {
                  "state": "New South Wales",
                  "interest": 95,
                  "abbrev": "NSW"
                },
                {
                  "state": "South Australia",
                  "interest": 91,
                  "abbrev": "SA"
                },
                {
                  "state": "Western Australia",
                  "interest": 91,
                  "abbrev": "WA"
                },
                {
                  "state": "Australian Capital Territory",
                  "interest": 88,
                  "abbrev": "ACT"
                },
                {
                  "state": "Queensland",
                  "interest": 79,
                  "abbrev": "QLD"
                },
                {
                  "state": "Northern Territory",
                  "interest": 63,
                  "abbrev": "NT"
                },
                {
                  "state": "Tasmania",
                  "interest": 57,
                  "abbrev": "TAS"
                }
              ]
            },
            "key": "state",
            "fields": [
              "interest",
              "abbrev"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "interest",
          "type": "quantitative",
          "title": "Interest",
          "scale": {
            "scheme": "reds",
            "domain": [
              0,
              100
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "interest",
            "title": "Interest (0–100)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "abbrev": "NSW",
            "lon": 147.0,
            "lat": -32.5
          },
          {
            "abbrev": "VIC",
            "lon": 144.5,
            "lat": -37.0
          },
          {
            "abbrev": "QLD",
            "lon": 144.0,
            "lat": -22.5
          },
          {
            "abbrev": "WA",
            "lon": 121.5,
            "lat": -26.0
          },
          {
            "abbrev": "SA",
            "lon": 135.0,
            "lat": -30.0
          },
          {
            "abbrev": "TAS",
            "lon": 146.7,
            "lat": -42.0
          },
          {
            "abbrev": "NT",
            "lon": 133.5,
            "lat": -19.5
          },
          {
            "abbrev": "ACT",
            "lon": 149.2,
            "lat": -35.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "fill": "#1a1a2e",
        "stroke": "white",
        "strokeWidth": 2,
        "strokeJoin": "round",
        "paintOrder": "stroke",
        "strokeOpacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "abbrev"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": {
    "left": 24,
    "right": 24,
    "top": 8,
    "bottom": 8
  }
}