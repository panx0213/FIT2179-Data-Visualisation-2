{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Per-Capita K-pop Devotion",
    "subtitle": "State population vs K-pop search interest — bubble size = number of K-pop concerts since 2015 (PLACEHOLDER DATA)",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#666"
  },
  "width": "container",
  "height": 360,
  "data": {
    "values": [
      {"state": "NSW", "pop_millions": 8.34, "interest": 78, "concerts": 14},
      {"state": "VIC", "pop_millions": 6.96, "interest": 84, "concerts": 12},
      {"state": "QLD", "pop_millions": 5.56, "interest": 62, "concerts":  4},
      {"state": "WA",  "pop_millions": 2.97, "interest": 71, "concerts":  3},
      {"state": "SA",  "pop_millions": 1.87, "interest": 58, "concerts":  2},
      {"state": "TAS", "pop_millions": 0.58, "interest": 49, "concerts":  0},
      {"state": "ACT", "pop_millions": 0.47, "interest": 88, "concerts":  1},
      {"state": "NT",  "pop_millions": 0.25, "interest": 41, "concerts":  0}
    ]
  },
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 0.7, "stroke": "#1a1a2e", "strokeWidth": 1},
      "encoding": {
        "x": {
          "field": "pop_millions",
          "type": "quantitative",
          "title": "State population (millions)",
          "scale": {"type": "log"}
        },
        "y": {"field": "interest", "type": "quantitative", "title": "K-pop search interest (0–100)"},
        "size": {
          "field": "concerts",
          "type": "quantitative",
          "title": "Concerts",
          "scale": {"range": [80, 1200]}
        },
        "color": {"value": "#e94560"},
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "pop_millions", "title": "Population (M)"},
          {"field": "interest", "title": "K-pop interest"},
          {"field": "concerts", "title": "Concerts"}
        ]
      }
    },
    {
      "mark": {"type": "text", "dy": -16, "fontWeight": "bold", "color": "#1a1a2e"},
      "encoding": {
        "x": {"field": "pop_millions", "type": "quantitative", "scale": {"type": "log"}},
        "y": {"field": "interest", "type": "quantitative"},
        "text": {"field": "state"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
